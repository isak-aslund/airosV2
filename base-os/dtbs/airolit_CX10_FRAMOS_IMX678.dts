// SPDX-License-Identifier: GPL-2.0
/*
 * Airolit CX10 - FRAMOS IMX678 Camera Overlay
 *
 * Requires: airolit_CX10_COMMON.dtbo loaded FIRST
 *
 * Enables:
 *   - sensor_module1
 *   - CSI channel 1 (port 1, 2 lanes)
 *   - VI port 1
 *   - I2C channel 1 with TCA6408 expander and FRAMOS IMX678 sensor
 *
 * Hardware:
 *   - Camera connector: CAM1
 *   - CSI port: 1
 *   - I2C address: 0x1a
 *   - Video node: video1
 */

/dts-v1/;
/plugin/;

#define CAM0_PWDN    TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_PWDN    TEGRA234_MAIN_GPIO(AC, 0)
#define CAM_I2C_MUX  TEGRA234_AON_GPIO(CC, 3)

/* FRAMOS TCA6408 GPIO pins */
#define PW_EN        0
#define CRESETB      1
#define XMASTER      3

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3767-0000-common.h>

/ {
    overlay-name = "Airolit CX10 FRAMOS IMX678 Camera";
    jetson-header-name = "Jetson 24pin CSI Connector";
    compatible = JETSON_COMPATIBLE_P3768;

    // ========================================================================
    // FRAGMENT 0: Enable sensor_module1 for FRAMOS IMX678
    // ========================================================================
    fragment@0 {
        target = <&sensor_module1>;
        __overlay__ {
            status = "okay";
            badge = "imx678_front_framos";
            drivernode0 {
                status = "okay";
                devname = "imx678 9-001a";
				sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@1/imx678_c@1a";
            };
        };
    };

    // ========================================================================
    // FRAGMENT 1: Enable VI port 2
    // ========================================================================
    fragment@1 {
        target = <&sensor_vi_port1>;
        __overlay__ {
            status = "okay";
        };
    };

    fragment@2 {
        target = <&sensor_vi_in1>;
        __overlay__ {
            status = "okay";
            bus-width = <2>;
        };
    };

    // ========================================================================
    // FRAGMENT 3: Enable CSI channel 2
    // ========================================================================
    fragment@3 {
        target = <&sensor_csi_ch1>;
        __overlay__ {
            status = "okay";
			ports {
				status = "okay";
			};
        };
    };

    fragment@4 {
        target = <&sensor_csi_ch1_port0>;
        __overlay__ {
            status = "okay";
        };
    };

	fragment@5 {
        target = <&sensor_csi_ch1_port1>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@6 {
        target = <&sensor_csi_ch1_in>;
		__overlay__ {
			status = "okay";
			bus-width = <2>;
			remote-endpoint = <&framos_imx678_out>;
		};
	};

    fragment@7 {
        target = <&sensor_csi_ch1_out>;
        __overlay__ {
            status = "okay";
        };
    };

    // ========================================================================
    // FRAGMENT 8: Add I2C channel 1 with FRAMOS IMX678 sensor
    // ========================================================================
    fragment@8 {
        /* Channel connected to CAM1 */
        target = <&cam_i2cmux_i2c1>;
        __overlay__ {
            status = "okay";
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;

            reset-gpios = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;
            xmaster-gpio = <&tca6408_20_cam_i2cmux_i2c1 XMASTER GPIO_ACTIVE_HIGH>;
            cresetb = <&tca6408_20_cam_i2cmux_i2c1 CRESETB GPIO_ACTIVE_HIGH>;
            pwdn-gpios = <&tca6408_20_cam_i2cmux_i2c1 PW_EN GPIO_ACTIVE_HIGH>;

            // ============================================================
            // TCA6408: GPIO Expander for FRAMOS IMX678
            // ============================================================
            tca6408_20_cam_i2cmux_i2c1: tca6408@20 {
                compatible = "ti,tca6408";
                gpio-controller;
                #gpio-cells = <2>;
                reg = <0x20>;
                status = "okay";
                /* P0: PW_EN */
                tca6408_20_i2c1_pw_en {
                    gpio-hog;
                    output-high;
                    gpios = <PW_EN 0>;
                    label = "pw_en";
                    status = "okay";
                };
                /* P1: CRESETB */
                tca6408_20_i2c1_cresetb {
                    gpio-hog;
                    output-high;
                    gpios = <CRESETB 0>;
                    label = "cresetb";
                    status = "okay";
                };
                /* P3: XMASTER */
                tca6408_20_i2c1_xmaster {
                    gpio-hog;
                    output-low;
                    gpios = <XMASTER 0>;
                    label = "xmaster";
                    status = "okay";
                };
            };

            // ============================================================
            // IMX678: FRAMOS Camera Sensor
            // ============================================================
            imx678_c@1a {
                compatible = "framos,imx678";
                reg = <0x1a>;
                /* Define any required hw resources needed by driver */
                /* ie. clocks, io pins, power sources */
                clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
                            <&bpmp TEGRA234_CLK_EXTPERIPH1>;
                clock-names = "extperiph1", "pllp_grtba";
                mclk = "extperiph1";
                clock-frequency = <37125000>;

                devnode = "video1";
                physical_w = "20.00";
                physical_h = "16.80";
                sensor_model = "imx678";

                /* Defines number of frames to be dropped by driver internally after applying */
                /* sensor crop settings. Some sensors send corrupt frames after applying */
                /* crop co-ordinates */
                post_crop_frame_drop = "0";

                /* Convert Gain to unit of dB (decibel) befor passing to kernel driver */
                use_decibel_gain = "true";

                /* if true, delay gain setting by one frame to be in sync with exposure */
                delayed_gain = "false";

                /* enable CID_SENSOR_MODE_ID for sensor modes selection */
                use_sensor_mode_id = "false";

                /* Sensor modes - copied from FRAMOS overlay */
                mode0 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "3856";
                    active_h = "2180";

                    dynamic_pixel_bit_depth = "12";
                    csi_pixel_bit_depth = "12";
                    mode_type = "bayer";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
                    serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

                    gain_factor = "10";
                    min_gain_val = "0"; /* 0dB */
                    max_gain_val = "720"; /* 72dB */
                    step_gain_val = "3"; /* 0.3 */
                    default_gain = "0";
                    min_hdr_ratio = "1";
                    max_hdr_ratio = "64";
                    framerate_factor = "1000000";
                    min_framerate = "1500000"; /* 1.5 */
                    max_framerate = "30000000"; /* 30 */
                    step_framerate = "1";
                    default_framerate= "30000000";
                    exposure_factor = "1000000";
                    min_exp_time = "27"; /* us */
                    max_exp_time = "660000"; /* us */
                    step_exp_time = "1";
                    default_exp_time = "10000";/* us */
                    embedded_metadata_height = "1";
                };
                mode1 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "2608";
                    active_h = "1964";

                    dynamic_pixel_bit_depth = "12";
                    csi_pixel_bit_depth = "12";
                    mode_type = "bayer";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
                    serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

                    gain_factor = "10";
                    min_gain_val = "0"; /* 0dB */
                    max_gain_val = "720"; /* 72dB */
                    step_gain_val = "3"; /* 0.3 */
                    default_gain = "0";
                    min_hdr_ratio = "1";
                    max_hdr_ratio = "64";
                    framerate_factor = "1000000";
                    min_framerate = "1500000"; /* 1.5 */
                    max_framerate = "33000000"; /* 33 */
                    step_framerate = "1";
                    default_framerate= "33000000";
                    exposure_factor = "1000000";
                    min_exp_time = "27"; /* us */
                    max_exp_time = "660000"; /* us */
                    step_exp_time = "1";
                    default_exp_time = "10000";/* us */
                    embedded_metadata_height = "1";
                };
                mode2 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "1920";
                    active_h = "1080";

                    dynamic_pixel_bit_depth = "12";
                    csi_pixel_bit_depth = "12";
                    mode_type = "bayer";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
                    serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

                    gain_factor = "10";
                    min_gain_val = "0"; /* 0dB */
                    max_gain_val = "720"; /* 72dB */
                    step_gain_val = "3"; /* 0.3 */
                    default_gain = "0";
                    min_hdr_ratio = "1";
                    max_hdr_ratio = "64";
                    framerate_factor = "1000000";
                    min_framerate = "1500000"; /* 1.5 */
                    max_framerate = "59000000"; /* 59 */
                    step_framerate = "1";
                    default_framerate= "59000000";
                    exposure_factor = "1000000";
                    min_exp_time = "27"; /* us */
                    max_exp_time = "660000"; /* us */
                    step_exp_time = "1";
                    default_exp_time = "10000";/* us */
                    embedded_metadata_height = "1";
                };
                mode3 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "1928";
                    active_h = "1090";

                    dynamic_pixel_bit_depth = "12";
                    csi_pixel_bit_depth = "12";
                    mode_type = "bayer";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
                    serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

                    gain_factor = "10";
                    min_gain_val = "0"; /* 0dB */
                    max_gain_val = "720"; /* 72dB */
                    step_gain_val = "3"; /* 0.3 */
                    default_gain = "0";
                    min_hdr_ratio = "1";
                    max_hdr_ratio = "64";
                    framerate_factor = "1000000";
                    min_framerate = "1500000"; /* 1.5 */
                    max_framerate = "30000000"; /* 30 */
                    step_framerate = "1";
                    default_framerate= "30000000";
                    exposure_factor = "1000000";
                    min_exp_time = "27"; /* us */
                    max_exp_time = "660000"; /* us */
                    step_exp_time = "1";
                    default_exp_time = "10000";/* us */
                    embedded_metadata_height = "1";
                };
                mode4 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "3856";
                    active_h = "2180";

                    dynamic_pixel_bit_depth = "10";
                    csi_pixel_bit_depth = "10";
                    mode_type = "bayer";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
                    serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

                    gain_factor = "10";
                    min_gain_val = "0"; /* 0dB */
                    max_gain_val = "720"; /* 72dB */
                    step_gain_val = "3"; /* 0.3 */
                    default_gain = "0";
                    min_hdr_ratio = "1";
                    max_hdr_ratio = "64";
                    framerate_factor = "1000000";
                    min_framerate = "1500000"; /* 1.5 */
                    max_framerate = "30000000"; /* 30 */
                    step_framerate = "1";
                    default_framerate= "30000000";
                    exposure_factor = "1000000";
                    min_exp_time = "27"; /* us */
                    max_exp_time = "660000"; /* us */
                    step_exp_time = "1";
                    default_exp_time = "10000";/* us */
                    embedded_metadata_height = "1";
                };
                mode5 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "2608";
                    active_h = "1964";

                    dynamic_pixel_bit_depth = "10";
                    csi_pixel_bit_depth = "10";
                    mode_type = "bayer";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
                    serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

                    gain_factor = "10";
                    min_gain_val = "0"; /* 0dB */
                    max_gain_val = "720"; /* 72dB */
                    step_gain_val = "3"; /* 0.3 */
                    default_gain = "0";
                    min_hdr_ratio = "1";
                    max_hdr_ratio = "64";
                    framerate_factor = "1000000";
                    min_framerate = "1500000"; /* 1.5 */
                    max_framerate = "33000000"; /* 33 */
                    step_framerate = "1";
                    default_framerate= "33000000";
                    exposure_factor = "1000000";
                    min_exp_time = "27"; /* us */
                    max_exp_time = "660000"; /* us */
                    step_exp_time = "1";
                    default_exp_time = "10000";/* us */
                    embedded_metadata_height = "1";
                };
                mode6 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "1920";
                    active_h = "1080";

                    dynamic_pixel_bit_depth = "10";
                    csi_pixel_bit_depth = "10";
                    mode_type = "bayer";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
                    serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

                    gain_factor = "10";
                    min_gain_val = "0"; /* 0dB */
                    max_gain_val = "720"; /* 72dB */
                    step_gain_val = "3"; /* 0.3 */
                    default_gain = "0";
                    min_hdr_ratio = "1";
                    max_hdr_ratio = "64";
                    framerate_factor = "1000000";
                    min_framerate = "1500000"; /* 1.5 */
                    max_framerate = "59000000"; /* 59 */
                    step_framerate = "1";
                    default_framerate= "59000000";
                    exposure_factor = "1000000";
                    min_exp_time = "27"; /* us */
                    max_exp_time = "660000"; /* us */
                    step_exp_time = "1";
                    default_exp_time = "10000";/* us */
                    embedded_metadata_height = "1";
                };
                mode7 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "3872";
                    active_h = "4568";

                    dynamic_pixel_bit_depth = "10";
                    csi_pixel_bit_depth = "10";
                    mode_type = "bayer_wdr_dol";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
                    serdes_pix_clk_hz = "12000000000"; /* GMSL predefine */

                    gain_factor = "10";
                    min_gain_val = "0"; /* 0dB */
                    max_gain_val = "720"; /* 72dB */
                    step_gain_val = "3"; /* 0.3 */
                    default_gain = "0";
                    min_hdr_ratio = "16";
                    max_hdr_ratio = "16";
                    framerate_factor = "1000000";
                    min_framerate = "1500000"; /* 1.5 */
                    max_framerate = "30000000"; /* 60 */
                    step_framerate = "1";
                    default_framerate= "30000000";
                    exposure_factor = "1000000";
                    min_exp_time = "948"; /* us */
                    max_exp_time = "38874"; /* us */
                    step_exp_time = "1";
                    default_exp_time = "10000";/* us */
                    embedded_metadata_height = "1";

                    /* HDR */
                    num_of_exposure = "2";
                    num_of_lines_offset_0 = "124";
                    num_of_ignored_pixels = "16";
                    num_of_left_margin_pixels = "8";
                    num_of_right_margin_pixels = "8";
                };
                mode8 {
                    mclk_khz = "37125";
                    num_lanes = "2";
                    tegra_sinterface = "serial_c";
                    vc_id = "0";
                    phy_mode = "DPHY";
                    discontinuous_clk = "no";
                    dpcm_enable = "false";
                    cil_settletime = "0";
                    lane_polarity = "0";
                    active_w = "3872";
                    active_h = "4568";

                    dynamic_pixel_bit_depth = "12";
                    csi_pixel_bit_depth = "12";
                    mode_type = "bayer_wdr_dol";
                    pixel_phase = "rggb";

                    readout_orientation = "0";
                    line_length = "6600";
                    inherent_gain = "1";
                    pix_clk_hz = "346500000";
