                };

                ports {
                    #address-cells = <1>;
                    #size-cells = <0>;
                    port@0 {
                        reg = <0>;
                        framos_imx678_out: endpoint {
                            vc-id = <0>;
                            port-index = <2>;
                            bus-width = <2>;
