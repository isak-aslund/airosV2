#!/bin/bash
set -euo pipefail

export LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:/usr/lib/tegra

# Wait for nvargus-daemon socket (up to 30 s)
timeout=30
elapsed=0
while [ ! -e /tmp/argus_socket ]; do
    if [ "$elapsed" -ge "$timeout" ]; then
        echo "imx678-stream: /tmp/argus_socket not found after ${timeout}s" >&2
        exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done

exec gst-launch-1.0 \
    nvarguscamerasrc sensor-id=0 sensor-mode=0 \
    ! "video/x-raw(memory:NVMM), width=(int)1920, height=(int)1080, format=(string)NV12" \
    ! nvvidconv \
    ! "video/x-raw(memory:NVMM), width=(int)1920, height=(int)1080, format=(string)NV12" \
    ! nvv4l2h264enc bitrate=2000000 \
    ! rtspclientsink location=rtsp://localhost:8554/fpv
